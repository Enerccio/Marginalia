<?xml version="1.0" encoding="UTF-8"?>
<!-- Development logging (IDE, mvn jetty:run, tests); the WAR gets resources-release/logback.xml instead -->
<configuration>
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <!-- Date [Thread] Level Category - Message -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{1} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.github.enerccio" level="DEBUG"/>
    <logger name="org.apache.catalina" level="DEBUG"/>
    <logger name="org.springframework.web" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="stdout"/>
    </root>
</configuration>
