<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.enerccio</groupId>
        <artifactId>marginalia-parent</artifactId>
        <version>1.9.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <groupId>com.github.enerccio.marginalia.extensions</groupId>
    <artifactId>http-hooks</artifactId>
    <packaging>jar</packaging>
    <name>http-hooks</name>
    <description>What the plugins that call a server of the user share: the HTTP call with a size limit and without redirects, the guard
        for private addresses, the hook that frees or takes the GPU, the gate that lets several users share one GPU, and the settings form of a list of hooks. It is a plain jar
        (the JDK for all but the form in the ui package, which uses Vaadin from the application) that each plugin embeds in its bundle (plugins do not see each other's classes), never installed as an extension.</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vaadin.version>25.2.3</vaadin.version>
    </properties>

    <dependencies>
        <!-- Only the settings form of the hook list (ui package) needs them: the plugins that embed the library have them from the application -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
            <version>${vaadin.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.addons</groupId>
            <artifactId>font-awesome-iron-iconset</artifactId>
            <version>6.0.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- SharedGate: the gates live in the application, so that two extensions on one GPU find the same one -->
        <dependency>
            <groupId>io.github.enerccio</groupId>
            <artifactId>marginalia</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <classifier>classes</classifier>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
