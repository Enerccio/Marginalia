<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="userRepository" class="com.github.enerccio.marginalia.domain.security.repository.impl.JpaUserRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.security.service.impl.UserServiceImpl">
        <property name="repository" ref="userRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.InferenceServicesImpl">
        <property name="inferenceProviders">
            <list>
                <value>com.github.enerccio.marginalia.domain.service.impl.inference.OpenAICompatibleInferenceService</value>
            </list>
        </property>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TemplateServiceImpl" />

    <bean id="settingRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaSettingRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.SettingServiceImpl">
        <property name="repository" ref="settingRepository" />
    </bean>

    <bean id="resourceRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaResourceRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ResourceServiceImpl">
        <property name="repository" ref="resourceRepository" />
    </bean>

    <bean id="aiRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaAIRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.AIServiceImpl">
        <property name="repository" ref="aiRepository" />
    </bean>

    <bean id="protocolRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaProtocolRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ProtocolServiceImpl">
        <property name="repository" ref="protocolRepository" />
    </bean>

    <bean id="manuscriptRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaManuscriptRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ManuscriptServiceImpl">
        <property name="repository" ref="manuscriptRepository" />
    </bean>

    <bean id="tagRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaTagRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TagServiceImpl">
        <property name="repository" ref="tagRepository" />
    </bean>

    <bean id="tagRelationRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaTagRelationRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TagRelationServiceImpl">
        <property name="repository" ref="tagRelationRepository" />
    </bean>

    <bean id="chatMessageRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaChatMessageRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ChatMessageServiceImpl">
        <property name="repository" ref="chatMessageRepository" />
    </bean>

    <bean id="lorebookRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaLorebookRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.LorebookServiceImpl">
        <property name="repository" ref="lorebookRepository" />
    </bean>

    <bean id="lorebookEntryRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaLorebookEntryRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.LorebookEntryServiceImpl">
        <property name="repository" ref="lorebookEntryRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TokenizerServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.StoryGenerationServiceImpl">
        <property name="installedSteps">
            <list>
                <bean class="com.github.enerccio.marginalia.domain.service.impl.generation.impl.PrepareForGenerationStep" />
                <bean class="com.github.enerccio.marginalia.domain.service.impl.generation.impl.PrepareConstantsStep" />
                <bean class="com.github.enerccio.marginalia.domain.service.impl.generation.impl.ProcessLorebookStep" />
                <bean class="com.github.enerccio.marginalia.domain.service.impl.generation.impl.PrepareContentStep" />
                <bean class="com.github.enerccio.marginalia.domain.service.impl.generation.impl.CleanupStep" />
            </list>
        </property>
    </bean>

</beans>