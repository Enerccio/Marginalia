# the secret of the callers: LiteLLM sends it in the header X-Control-Token (headers of its pass_through_endpoints entry); use a long random string
GPU_CONTROL_TOKEN=change-me-to-a-long-random-string

# the containers that may be started and stopped: name=address that answers 200 when it is ready (container_name of each compose file)
GPU_CONTROL_CONTAINERS=comfyui-amd=http://comfyui-amd:8188/system_stats,chatterbox=http://chatterbox:8004/api/model-info

# START_TIMEOUT=180
# STOP_TIMEOUT=30
