{
  "format": 1,
  "id": "orrelian",
  "name": "Orrelian",
  "description": "The speech of the river people of Orrel: soft, verb first, with a formal court register.",
  "rules": [
    {
      "id": "632d089f-2e5e-4af5-b22c-627dccfc08b5",
      "title": "Sounds and spelling",
      "text": "Words have one or two syllables, built from the consonants th, k, r, l, n, s, v, d, m and the vowels a, e, i, o, u and ae. No double consonants. The stress falls on the first syllable.",
      "audience": "MODEL"
    },
    {
      "id": "f733ae46-0283-4bb5-94af-51143293624d",
      "title": "Grammar",
      "text": "The verb comes first, then the subject, then the object. A noun takes -ae for the plural. A question ends with the particle ve, a command starts with the particle ka. There is no word for \"the\" or \"a\". Speech at court uses the formal form of a word when it has one.",
      "audience": "MODEL"
    },
    {
      "id": "26808bb4-33e2-4c5b-8907-3e6aafde8e28",
      "title": "Word formation",
      "text": "A new word joins two roots with a hyphen, the describing root first: thal-orun, \"night river\". A name is never changed.",
      "audience": "MODEL"
    },
    {
      "id": "4d720853-5519-4c05-ac2a-3f6f28b1d38f",
      "title": "History of the language",
      "text": "The speech of the river people of Orrel. The formal forms come from the old court, the soft ones from the lullabies.",
      "audience": "DESIGNER"
    },
    {
      "id": "fe0b42e1-d10a-408d-a3e2-6567426906bc",
      "title": "My notes",
      "text": "Check the plural of the words that end in -ae.",
      "audience": "NONE"
    }
  ],
