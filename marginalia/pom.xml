  <build>
    <plugins>
      <plugin>
        <groupId>pl.project13.maven</groupId>
        <artifactId>git-commit-id-plugin</artifactId>
        <version>4.0.0</version>
        <executions>
          <execution>
            <id>get-the-git-infos</id>
            <goals>
              <goal>revision</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
        </executions>
        <configuration>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
          <includeOnlyProperties>
            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.id.full$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.user.email$</includeOnlyProperty>
            <includeOnlyProperty>^git.closest.tag.name$</includeOnlyProperty>
          </includeOnlyProperties>
          <commitIdGenerationMode>full</commitIdGenerationMode>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>UTF-8</encoding>
          <!-- same as the aspectj compiler, extensions resolve method arguments by name -->
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- RuntimeInstrumentationTest installs the ByteBuddy agent into the test JVM -->
          <argLine>-XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true</argLine>
          <systemPropertyVariables>
            <marginalia.test.home>${project.build.directory}/test-home</marginalia.test.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.eclipse.jetty.ee11</groupId>
        <artifactId>jetty-ee11-maven-plugin</artifactId>
        <version>12.1.14</version>
        <configuration>
          <webApp>
            <contextPath>/</contextPath>
          </webApp>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>12.1.14</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <filters>
            <filter>src/main/resources/META-INF/build-info/build-info.properties</filter>
            <filter>${project.build.outputDirectory}/git.properties</filter>
          </filters>
          <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
          <!-- the Vaadin build info (flow-build-info.json) comes only from vaadin-maven-plugin: build-frontend
               writes the production one into the WAR, a development one left in src/main/resources for IDE runs
               must never get there -->
          <packagingExcludes>**/gwt-unitCache/**,**/obsb.properties**,WEB-INF/classes/META-INF/VAADIN/config/flow-build-info.json.*</packagingExcludes>
          <webResources>
            <!-- release logging (INFO, no story content) - the WAR gets it instead of the development
                 log4j.properties, which stays in target/classes for IDE runs and mvn jetty:run -->
            <resource>
              <directory>src/main/resources-release</directory>
              <targetPath>WEB-INF/classes</targetPath>
              <filtering>false</filtering>
            </resource>

            <resource>
              <directory>src/main/resources</directory>
              <targetPath>WEB-INF/classes</targetPath>
              <filtering>true</filtering>
              <excludes>
                <exclude>META-INF/VAADIN/config/flow-build-info.json*</exclude>
                <exclude>log4j.properties</exclude>
              </excludes>
            </resource>

            <resource>
              <directory>src/main/resources-raw</directory>
              <targetPath>WEB-INF/classes</targetPath>
              <filtering>false</filtering>
            </resource>
          </webResources>
          <attachClasses>true</attachClasses>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-maven-plugin</artifactId>
        <version>${vaadin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>clean-frontend</goal>
              <goal>prepare-frontend</goal>
              <goal>build-frontend</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>aspectj-maven-plugin</artifactId>
        <version>1.16.0</version>
        <dependencies>
          <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjrt</artifactId>
            <version>1.9.25.1</version>
          </dependency>
          <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjtools</artifactId>
            <version>1.9.25.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <complianceLevel>${java.version}</complianceLevel>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>UTF-8</encoding>
          <aspectLibraries>
            <aspectLibrary>
              <groupId>org.springframework</groupId>
              <artifactId>spring-aspects</artifactId>
            </aspectLibrary>
          </aspectLibraries>

          <preserveAllLocals>true</preserveAllLocals>
          <additionalCompilerArgs>
            <arg>-g</arg>
            <arg>-parameters</arg>
          </additionalCompilerArgs>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>test-compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!--
      Desktop distribution: mvn package -Pdesktop

      Builds a self-contained Marginalia for personal computers - no installed Java or server needed:
        target/desktop/marginalia-<version>/   portable folder: bin/marginalia(.bat), app/ (launcher),
                                               server/ (jetty-home + marginalia.war), runtime/ (jlink)
        target/desktop/package/                native app made by jpackage (Marginalia.app on macOS,
                                               Marginalia/ with an .exe on Windows, bin/Marginalia on Linux)
        target/desktop/marginalia-<version>-<os>-<arch>.tar.gz|zip       archive of the portable folder
        target/desktop/marginalia-<version>-<os>-<arch>-app.tar.gz|zip   archive of the native app

      The WAR is the same as for the server, packaged in Vaadin production mode, and it runs on jetty-home (the
      Jetty distribution the Docker image uses) started in-process by DesktopLauncher (src/desktop/java). The
      launcher listens on 127.0.0.1, opens the browser and offers a tray icon to open/quit.

      jlink/jpackage come from the JDK running Maven and produce a runtime for the current OS and CPU only, build on
      each target platform. jpackage needs a numeric version (no -SNAPSHOT), override with -Ddesktop.appVersion.
    -->
    <profile>
      <id>desktop</id>

      <properties>
        <desktop.dir>${project.build.directory}/desktop</desktop.dir>
        <desktop.dist>${desktop.dir}/marginalia-${project.version}</desktop.dist>
        <desktop.appVersion>${project.version}</desktop.appVersion>
        <desktop.jetty.version>12.1.10</desktop.jetty.version>
        <!-- JDK modules of the runtime image: the app, Jetty, the ByteBuddy agent (jdk.attach, java.instrument)
             and the tray icon / browser opening (java.desktop) -->
        <desktop.modules>java.base,java.compiler,java.datatransfer,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.security.sasl,java.sql,java.sql.rowset,java.transaction.xa,java.xml,java.xml.crypto,jdk.attach,jdk.charsets,jdk.crypto.ec,jdk.localedata,jdk.management,jdk.naming.dns,jdk.net,jdk.unsupported,jdk.zipfs</desktop.modules>
        <desktop.javaOptions>-Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading --enable-native-access=ALL-UNNAMED</desktop.javaOptions>
      </properties>

      <build>
        <plugins>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>desktop-distribution</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <property name="app" value="${desktop.dist}/app"/>
                    <!-- server files are not on the launcher's classpath (jpackage would put every jar there) -->
                    <property name="server" value="${desktop.dist}/server"/>
                    <condition property="desktop.os" value="windows">
                      <os family="windows"/>
                    </condition>
                    <condition property="desktop.os" value="macos">
                      <os family="mac"/>
                    </condition>
                    <property name="desktop.os" value="linux"/>

                    <delete dir="${desktop.dist}"/>
                    <delete dir="${desktop.dir}/package"/>
                    <delete dir="${desktop.dir}/classes"/>

                    <!-- launcher: JDK only, compiled apart from the webapp so it never gets into the WAR -->
                    <mkdir dir="${desktop.dir}/classes"/>
                    <javac srcdir="src/desktop/java" destdir="${desktop.dir}/classes" release="${java.version}"
                           includeantruntime="false" encoding="UTF-8" debug="true"/>
                    <mkdir dir="${app}"/>
                    <jar destfile="${app}/marginalia-launcher.jar" basedir="${desktop.dir}/classes">
                      <manifest>
                        <attribute name="Main-Class" value="com.github.enerccio.marginalia.desktop.DesktopLauncher"/>
                        <attribute name="Implementation-Version" value="${project.version}"/>
                      </manifest>
                    </jar>

                    <copy file="${project.build.directory}/${project.build.finalName}.war" tofile="${server}/marginalia.war"/>
                    <unzip src="${desktop.dir}/download/jetty-home-${desktop.jetty.version}.zip" dest="${server}/jetty-home">
                      <cutdirsmapper dirs="1"/>
                    </unzip>

                    <!-- trimmed Java runtime for this platform -->
                    <exec executable="${java.home}/bin/jlink" failonerror="true">
                      <arg value="--add-modules"/>
                      <arg value="${desktop.modules}"/>
                      <arg value="--strip-debug"/>
                      <arg value="--no-header-files"/>
                      <arg value="--no-man-pages"/>
                      <arg value="--compress=zip-6"/>
                      <arg value="--output"/>
                      <arg value="${desktop.dist}/runtime"/>
                    </exec>

                    <copy todir="${desktop.dist}/bin">
                      <fileset dir="src/desktop/bin"/>
                    </copy>
                    <chmod file="${desktop.dist}/bin/marginalia" perm="755"/>

                    <!-- native application (app image, no installer - needs no signing to try out) -->
                    <exec executable="${java.home}/bin/jpackage" failonerror="true">
                      <arg value="--type"/>
                      <arg value="app-image"/>
                      <arg value="--name"/>
                      <arg value="Marginalia"/>
                      <arg value="--app-version"/>
                      <arg value="${desktop.appVersion}"/>
                      <arg value="--vendor"/>
                      <arg value="enerccio"/>
                      <arg value="--input"/>
                      <arg value="${app}"/>
                      <arg value="--main-jar"/>
                      <arg value="marginalia-launcher.jar"/>
                      <arg value="--app-content"/>
                      <arg value="${server}"/>
                      <arg value="--runtime-image"/>
                      <arg value="${desktop.dist}/runtime"/>
                      <arg value="--java-options"/>
                      <arg value="${desktop.javaOptions} -Dapple.awt.UIElement=true"/>
                      <arg value="--dest"/>
                      <arg value="${desktop.dir}/package"/>
                    </exec>

                    <!-- archives of the portable folder and of the app image: tar keeps file permissions (an
                         app bundle or launcher without its executable bit is broken), Windows tar (bsdtar from
                         System32, not Git's GNU tar that may come first on PATH) writes zip -->
                    <property environment="env"/>
                    <condition property="desktop.archiveExt" value="zip" else="tar.gz">
                      <os family="windows"/>
                    </condition>
                    <condition property="desktop.tarFlags" value="-a -c -f" else="-c -z -f">
                      <os family="windows"/>
                    </condition>
                    <condition property="desktop.tar" value="${env.SystemRoot}\System32\tar.exe" else="tar">
                      <os family="windows"/>
                    </condition>
                    <property name="desktop.archiveBase" value="marginalia-${project.version}-${desktop.os}-${os.arch}"/>
                    <delete>
                      <fileset dir="${desktop.dir}" includes="marginalia-*.tar.gz,marginalia-*.zip"/>
                    </delete>
                    <exec executable="${desktop.tar}" dir="${desktop.dir}" failonerror="true">
                      <arg line="${desktop.tarFlags}"/>
                      <arg value="${desktop.archiveBase}.${desktop.archiveExt}"/>
                      <arg value="marginalia-${project.version}"/>
                    </exec>
                    <exec executable="${desktop.tar}" dir="${desktop.dir}/package" failonerror="true">
                      <arg line="${desktop.tarFlags}"/>
                      <arg value="../${desktop.archiveBase}-app.${desktop.archiveExt}"/>
                      <arg value="."/>
                    </exec>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>desktop-jetty-home</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.eclipse.jetty</groupId>
                      <artifactId>jetty-home</artifactId>
                      <version>${desktop.jetty.version}</version>
                      <type>zip</type>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${desktop.dir}/download</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>
</project>
